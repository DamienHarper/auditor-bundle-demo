{% extends 'base.html.twig' %}

{% block title %}Tags — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="page-title">Tags</h1>
        <p class="page-subtitle">{{ tags|length }} tag{% if tags|length != 1 %}s{% endif %}</p>
    </div>
    <a href="{{ path('app_tag_new') }}" class="btn btn-primary">+ New Tag</a>
</div>

{% if tags is empty %}
    <div class="card empty-state"><p>No tags yet.</p></div>
{% else %}
    <div class="grid grid-cards-4">
        {% for tag in tags %}
            <div class="card card-hover">
                <div class="card-body">
                    <div class="flex items-center gap-3 mb-3">
                        <div style="width:2rem;height:2rem;border-radius:50%;background:{{ tag.color }};flex-shrink:0;box-shadow:0 2px 8px {{ tag.color }}55"></div>
                        <div>
                            <p style="font-weight:700;color:var(--text-heading);margin:0;font-size:.9rem">{{ tag.name }}</p>
                            <p class="text-muted" style="font-size:.75rem;margin:.1rem 0 0;font-family:monospace">{{ tag.color }}</p>
                        </div>
                    </div>
                    <p class="text-muted" style="font-size:.8rem;margin:0 0 .875rem">{{ tag.posts|length }} post{% if tag.posts|length != 1 %}s{% endif %}</p>
                    <div class="flex gap-2">
                        <a href="{{ path('app_tag_edit', {id: tag.id}) }}" class="btn btn-ghost btn-xs">Edit</a>
                        <form method="post" action="{{ path('app_tag_delete', {id: tag.id}) }}" onsubmit="return confirm('Delete tag {{ tag.name }}?')" style="margin:0">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                            <button type="submit" class="btn btn-danger btn-xs">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
