{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} — AuditorBundle Demo{% endblock %}

{% block body %}
<a href="{{ path('app_post_index') }}" class="back-link">← All Posts</a>

<div class="grid grid-main-aside">
    <div class="space-y-6">
        <article class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-4" style="flex-wrap:wrap;gap:1rem">
                    <div style="flex:1">
                        <div class="flex flex-wrap gap-1" style="margin-bottom:.75rem">
                            {% for tag in post.tags %}
                                <span class="tag-chip" style="background-color:{{ tag.color }}">{{ tag.name }}</span>
                            {% endfor %}
                        </div>
                        <h1 style="font-size:1.6rem;font-weight:800;color:var(--text-heading);margin:0 0 .5rem;letter-spacing:-.02em;line-height:1.25">{{ post.title }}</h1>
                        <div class="flex items-center gap-3" style="font-size:.875rem;color:var(--text-muted);flex-wrap:wrap">
                            {% if post.author %}
                                <span>by <a href="{{ path('app_author_show', {id: post.author.id}) }}" class="text-primary" style="font-weight:500">{{ post.author.name }}</a>
                                {% if post.coauthor %} &amp; <a href="{{ path('app_author_show', {id: post.coauthor.id}) }}" class="text-primary" style="font-weight:500">{{ post.coauthor.name }}</a>{% endif %}</span>
                            {% endif %}
                            <span class="badge badge-status-{{ post.status }}">{{ post.status }}</span>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('app_post_edit', {id: post.id}) }}" class="btn btn-secondary btn-sm">Edit</a>
                        <form method="post" action="{{ path('app_post_delete', {id: post.id}) }}" onsubmit="return confirm('Delete post?')" style="margin:0">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
                <hr class="divider">
                <div style="color:var(--text);line-height:1.8">{{ post.body|nl2br }}</div>
            </div>
        </article>

        {# Comments #}
        <div class="card">
            <div class="card-header">Comments ({{ post.comments|length }})</div>
            <div class="card-body">
                {% if post.comments is empty %}
                    <p class="text-muted" style="font-size:.875rem;margin:0 0 1.5rem">No comments yet.</p>
                {% else %}
                    <div class="space-y-3" style="margin-bottom:1.5rem">
                        {% for comment in post.comments %}
                            <div class="card" style="border-radius:8px">
                                <div class="card-body" style="padding:1rem">
                                    <div class="flex items-center justify-between mb-2">
                                        <span style="font-weight:600;font-size:.875rem;color:var(--text-heading)">{{ comment.authorName }}</span>
                                        <div class="flex items-center gap-3">
                                            <span class="text-muted" style="font-size:.75rem">{{ comment.createdAt ? comment.createdAt|date('M d, H:i') : '' }}</span>
                                            <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Delete comment?')" style="margin:0">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                                <button type="submit" class="btn btn-danger btn-xs">×</button>
                                            </form>
                                        </div>
                                    </div>
                                    <p style="font-size:.875rem;color:var(--text);margin:0">{{ comment.body }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                <hr class="divider">
                <p style="font-size:.875rem;font-weight:600;color:var(--text-heading);margin:0 0 .75rem">Add a comment</p>
                {{ form_start(comment_form, {action: path('app_comment_new', {id: post.id}), method: 'POST', attr: {class: 'space-y-3'}}) }}
                    <div>
                        {{ form_label(comment_form.authorName, null, {label_attr: {class: 'form-label', style: 'font-size:.8rem'}}) }}
                        {{ form_widget(comment_form.authorName, {attr: {class: 'form-input'}}) }}
                    </div>
                    <div>
                        {{ form_label(comment_form.body, null, {label_attr: {class: 'form-label', style: 'font-size:.8rem'}}) }}
                        {{ form_widget(comment_form.body, {attr: {class: 'form-textarea', rows: 3}}) }}
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
                {{ form_end(comment_form) }}
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-header">Audit Trail</div>
            <div class="card-body">
                <a href="{{ path('dh_auditor_show_entity_stream', {entity: 'App-Entity-Post', id: post.id}) }}" class="btn btn-secondary" style="width:100%;justify-content:center">
                    View full audit history →
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
