{% extends 'base.html.twig' %}

{% block title %}Posts — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold text-white">All Posts</h1>
        <p class="text-gray-400 mt-1">{{ posts|length }} post{% if posts|length != 1 %}s{% endif %}</p>
    </div>
    <a href="{{ path('app_post_new') }}" class="px-4 py-2 rounded-lg text-sm font-medium text-white" style="background-color:#4f46e5">+ New Post</a>
</div>

{% if posts is empty %}
    <div class="text-center py-16" style="background-color:#111827;border:1px solid #1f2937;border-radius:.75rem">
        <p class="text-gray-400">No posts yet.</p>
    </div>
{% else %}
    <div style="background-color:#111827;border:1px solid #1f2937;border-radius:.75rem;overflow:hidden">
        <table class="w-full">
            <thead>
                <tr style="border-bottom:1px solid #1f2937">
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Title</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Author</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Tags</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Comments</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                    <tr style="border-bottom:1px solid #1f2937" class="hover:bg-gray-900/50 transition">
                        <td class="px-4 py-3">
                            <a href="{{ path('app_post_show', {id: post.id}) }}" class="font-medium text-white hover:text-indigo-300">{{ post.title }}</a>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-400">
                            {% if post.author %}{{ post.author.name }}{% else %}<span class="text-gray-600">—</span>{% endif %}
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-xs px-2 py-0.5 rounded font-medium" style="{% if post.status == 'published' %}background-color:#14532d;color:#86efac{% else %}background-color:#1f2937;color:#9ca3af{% endif %}">{{ post.status }}</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-1">
                                {% for tag in post.tags %}
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs text-white" style="background-color:{{ tag.color }}">{{ tag.name }}</span>
                                {% endfor %}
                            </div>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-400">{{ post.comments|length }}</td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center gap-2 justify-end">
                                <a href="{{ path('app_post_edit', {id: post.id}) }}" class="px-2 py-1 text-xs rounded" style="background-color:#312e81;color:#c7d2fe">Edit</a>
                                <form method="post" action="{{ path('app_post_delete', {id: post.id}) }}" onsubmit="return confirm('Delete post?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                    <button type="submit" class="px-2 py-1 text-xs rounded" style="background-color:#450a0a;color:#fca5a5">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
