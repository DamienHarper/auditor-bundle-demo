{% extends 'base.html.twig' %}

{% block title %}Login — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="min-h-[60vh] flex items-center justify-center">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white">Sign in</h1>
            <p class="text-gray-400 mt-2">Access the audit journal and CRUD operations</p>
        </div>

        <div style="background-color:#111827;border:1px solid #1f2937;border-radius:.75rem" class="p-8">
            {% if error %}
                <div class="mb-4 px-4 py-3 rounded-lg text-sm" style="background-color:rgba(127,29,29,.5);border:1px solid #b91c1c;color:#fca5a5">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post">
                <div class="space-y-4">
                    <div>
                        <label for="username" class="block text-sm font-medium text-gray-300 mb-1">Email</label>
                        <input type="email" id="username" name="_username" value="{{ last_username }}"
                               autocomplete="email" autofocus
                               class="w-full rounded-lg text-white placeholder-gray-400 px-4 py-2.5"
                               style="background-color:#1f2937;border:1px solid #374151"
                               placeholder="admin@blog.com">
                    </div>
                    <div>
                        <label for="password" class="block text-sm font-medium text-gray-300 mb-1">Password</label>
                        <input type="password" id="password" name="_password" autocomplete="current-password"
                               class="w-full rounded-lg text-white placeholder-gray-400 px-4 py-2.5"
                               style="background-color:#1f2937;border:1px solid #374151"
                               placeholder="••••••••">
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="w-full py-2.5 rounded-lg text-sm font-semibold text-white mt-2" style="background-color:#4f46e5">
                        Sign in
                    </button>
                </div>
            </form>

            <div class="mt-6 pt-6" style="border-top:1px solid #1f2937">
                <p class="text-xs text-gray-500 text-center mb-3">Demo credentials:</p>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="p-2 rounded" style="background-color:#0d111d;border:1px solid #1f2937">
                        <p class="text-gray-300 font-medium">Admin</p>
                        <p class="text-gray-500">admin@blog.com</p>
                        <p class="text-gray-500">password</p>
                    </div>
                    <div class="p-2 rounded" style="background-color:#0d111d;border:1px solid #1f2937">
                        <p class="text-gray-300 font-medium">Editor</p>
                        <p class="text-gray-500">editor@blog.com</p>
                        <p class="text-gray-500">password</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
