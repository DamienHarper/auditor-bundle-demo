{% extends 'base.html.twig' %}

{% block title %}Authors — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="page-title">Authors</h1>
        <p class="page-subtitle">{{ authors|length }} author{% if authors|length != 1 %}s{% endif %}</p>
    </div>
    <a href="{{ path('app_author_new') }}" class="btn btn-primary">+ New Author</a>
</div>

{% if authors is empty %}
    <div class="card empty-state"><p>No authors yet.</p></div>
{% else %}
    <div class="grid grid-cards-3">
        {% for author in authors %}
            <div class="card card-hover">
                <div class="card-body">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <h2 style="font-size:1rem;font-weight:700;color:var(--text-heading);margin:0">{{ author.name }}</h2>
                            <p class="text-primary" style="font-size:.8rem;margin:.15rem 0 0">{{ author.email }}</p>
                        </div>
                        <span class="badge badge-entity">{{ author.posts|length }} post{% if author.posts|length != 1 %}s{% endif %}</span>
                    </div>
                    {% if author.bio %}
                        <p style="font-size:.875rem;color:var(--text-muted);margin:.5rem 0 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{{ author.bio }}</p>
                    {% endif %}
                    <div class="flex gap-2" style="margin-top:1rem">
                        <a href="{{ path('app_author_show', {id: author.id}) }}" class="btn btn-secondary btn-xs">View</a>
                        <a href="{{ path('app_author_edit', {id: author.id}) }}" class="btn btn-ghost btn-xs">Edit</a>
                        <form method="post" action="{{ path('app_author_delete', {id: author.id}) }}" onsubmit="return confirm('Delete {{ author.name }}?')" style="margin:0">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ author.id) }}">
                            <button type="submit" class="btn btn-danger btn-xs">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
