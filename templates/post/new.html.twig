{% extends 'base.html.twig' %}

{% block title %}New Post — AuditorBundle Demo{% endblock %}

{% block body %}
<a href="{{ path('app_post_index') }}" class="back-link">← Posts</a>

<div class="max-w-3xl">
    <h1 class="page-title mb-6">New Post</h1>
    <div class="card">
        <div class="card-body">
            {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
                {% for field in form %}
                    <div>
                        {{ form_label(field, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(field, {attr: {class: field.vars.block_prefixes|last in ['textarea', 'entity'] ? (field.vars.block_prefixes|last == 'entity' and field.vars.multiple is defined and field.vars.multiple ? 'form-select' : (field.vars.block_prefixes|last == 'entity' ? 'form-select' : 'form-textarea')) : 'form-input'}}) }}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
                <hr class="divider">
                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">Create Post</button>
                    <a href="{{ path('app_post_index') }}" class="btn btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
