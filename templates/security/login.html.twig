{% extends 'base.html.twig' %}

{% block title %}Login — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-center" style="min-height:60vh">
    <div style="width:100%;max-width:420px">
        <div class="text-center" style="margin-bottom:2rem">
            <h1 class="page-title">Sign in</h1>
            <p class="page-subtitle">Access the audit journal and CRUD operations</p>
        </div>

        <div class="card">
            <div class="card-body">
                {% if error %}
                    <div class="flash flash-error" style="margin-bottom:1rem">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="space-y-4">
                    <div>
                        <label for="username" class="form-label">Email</label>
                        <input type="email" id="username" name="_username" value="{{ last_username }}"
                               autocomplete="email" autofocus
                               class="form-input"
                               placeholder="admin@blog.com">
                    </div>
                    <div>
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" name="_password" autocomplete="current-password"
                               class="form-input"
                               placeholder="••••••••">
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn btn-primary" style="width:100%">Sign in</button>
                </form>

                <hr class="divider" style="margin-top:1.5rem">

                <p class="text-muted text-center" style="font-size:.75rem;margin-bottom:.75rem">Demo credentials:</p>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
                    <div class="card" style="padding:.625rem">
                        <p style="font-weight:600;font-size:.8rem;color:var(--text-heading);margin:0 0 .25rem">Admin</p>
                        <p class="text-muted" style="font-size:.75rem;margin:0">admin@blog.com</p>
                        <p class="text-muted" style="font-size:.75rem;margin:0">password</p>
                    </div>
                    <div class="card" style="padding:.625rem">
                        <p style="font-weight:600;font-size:.8rem;color:var(--text-heading);margin:0 0 .25rem">Editor</p>
                        <p class="text-muted" style="font-size:.75rem;margin:0">editor@blog.com</p>
                        <p class="text-muted" style="font-size:.75rem;margin:0">password</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
