{% extends 'base.html.twig' %}

{% block title %}Edit Post — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="mb-6">
    <a href="{{ path('app_post_show', {id: post.id}) }}" class="text-sm text-gray-400 hover:text-gray-300">&larr; {{ post.title }}</a>
</div>

<div class="max-w-3xl">
    <h1 class="text-2xl font-bold text-white mb-6">Edit Post</h1>
    <div style="background-color:#111827;border:1px solid #1f2937;border-radius:.75rem" class="p-6">
        {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
            {% for field in form %}
                <div>
                    {{ form_label(field, null, {label_attr: {class: 'block text-sm font-medium text-gray-300 mb-1'}}) }}
                    {{ form_widget(field) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <div class="flex gap-3 pt-4">
                <button type="submit" class="px-5 py-2 rounded-lg text-sm font-medium text-white" style="background-color:#4f46e5">Save Changes</button>
                <a href="{{ path('app_post_show', {id: post.id}) }}" class="px-5 py-2 rounded-lg text-sm font-medium" style="background-color:#1f2937;color:#d1d5db">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
