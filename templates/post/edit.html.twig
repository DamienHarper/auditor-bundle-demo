{% extends 'base.html.twig' %}

{% block title %}Edit Post — AuditorBundle Demo{% endblock %}

{% block body %}
<a href="{{ path('app_post_show', {id: post.id}) }}" class="back-link">← {{ post.title }}</a>

<div class="max-w-3xl">
    <h1 class="page-title mb-6">Edit Post</h1>
    <div class="card">
        <div class="card-body">
            {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
                {% for field in form %}
                    <div>
                        {{ form_label(field, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(field, {attr: {class: 'form-input'}}) }}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
                <hr class="divider">
                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="{{ path('app_post_show', {id: post.id}) }}" class="btn btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
