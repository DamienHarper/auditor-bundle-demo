{% extends 'base.html.twig' %}

{% block title %}Blog — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="page-title">Blog</h1>
        <p class="page-subtitle">Published posts</p>
    </div>
    <a href="{{ path('app_post_new') }}" class="btn btn-primary">+ New Post</a>
</div>

{% if posts is empty %}
    <div class="card empty-state">
        <p>No published posts yet.</p>
        <a href="{{ path('app_post_new') }}" class="btn btn-primary" style="margin-top:1rem">Create a post</a>
    </div>
{% else %}
    <div class="grid grid-cards-3">
        {% for post in posts %}
            <article class="card card-hover" style="display:flex;flex-direction:column">
                <div class="card-body" style="flex:1">
                    <div class="flex flex-wrap gap-1" style="margin-bottom:.75rem">
                        {% for tag in post.tags %}
                            <span class="tag-chip" style="background-color:{{ tag.color }}">{{ tag.name }}</span>
                        {% endfor %}
                    </div>
                    <h2 style="font-size:1.1rem;font-weight:700;color:var(--text-heading);margin:0 0 .5rem;line-height:1.3">
                        <a href="{{ path('app_post_show', {id: post.id}) }}" style="color:inherit;transition:color .15s" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='inherit'">
                            {{ post.title }}
                        </a>
                    </h2>
                    <p style="font-size:.875rem;color:var(--text-muted);margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
                        {{ post.excerpt ?? (post.body|slice(0,150) ~ (post.body|length > 150 ? '…' : '')) }}
                    </p>
                </div>
                <div style="padding:.875rem 1.5rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;font-size:.8rem;color:var(--text-muted)">
                    <span>
                        {% if post.author %}
                            by <a href="{{ path('app_author_show', {id: post.author.id}) }}" class="text-primary" style="font-weight:500">{{ post.author.name }}</a>
                            {% if post.coauthor %}&amp; <a href="{{ path('app_author_show', {id: post.coauthor.id}) }}" class="text-primary" style="font-weight:500">{{ post.coauthor.name }}</a>{% endif %}
                        {% else %}
                            No author
                        {% endif %}
                    </span>
                    <span>{{ post.createdAt ? post.createdAt|date('M d, Y') : '' }}</span>
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
