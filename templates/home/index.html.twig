{% extends 'base.html.twig' %}

{% block title %}Blog — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold text-white">Blog</h1>
        <p class="text-gray-400 mt-1">Published posts</p>
    </div>
    <a href="{{ path('app_post_new') }}" class="px-4 py-2 rounded-lg text-sm font-medium text-white" style="background-color:#4f46e5">
        + New Post
    </a>
</div>

{% if posts is empty %}
    <div class="text-center py-16" style="background-color:#111827;border:1px solid #1f2937;border-radius:.75rem">
        <p class="text-gray-400 text-lg">No published posts yet.</p>
        <a href="{{ path('app_post_new') }}" class="mt-4 inline-block px-4 py-2 rounded-lg text-sm text-white" style="background-color:#4f46e5">Create a post</a>
    </div>
{% else %}
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% for post in posts %}
            <article style="background-color:#111827;border:1px solid #1f2937;border-radius:.75rem;overflow:hidden" class="flex flex-col hover:border-indigo-800 transition">
                <div class="p-6 flex-1">
                    <div class="flex flex-wrap gap-1.5 mb-3">
                        {% for tag in post.tags %}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium text-white" style="background-color:{{ tag.color }}">
                                {{ tag.name }}
                            </span>
                        {% endfor %}
                    </div>
                    <h2 class="text-xl font-semibold text-white mb-2">
                        <a href="{{ path('app_post_show', {id: post.id}) }}" class="hover:text-indigo-300 transition">
                            {{ post.title }}
                        </a>
                    </h2>
                    {% if post.excerpt %}
                        <p class="text-gray-400 text-sm line-clamp-3">{{ post.excerpt }}</p>
                    {% else %}
                        <p class="text-gray-400 text-sm line-clamp-3">{{ post.body|slice(0, 150) }}{% if post.body|length > 150 %}…{% endif %}</p>
                    {% endif %}
                </div>
                <div class="px-6 py-4" style="border-top:1px solid #1f2937">
                    <div class="flex items-center justify-between text-xs text-gray-500">
                        <span>
                            {% if post.author %}
                                by <a href="{{ path('app_author_show', {id: post.author.id}) }}" class="text-indigo-400 hover:text-indigo-300">{{ post.author.name }}</a>
                                {% if post.coauthor %}
                                    &amp; <a href="{{ path('app_author_show', {id: post.coauthor.id}) }}" class="text-indigo-400 hover:text-indigo-300">{{ post.coauthor.name }}</a>
                                {% endif %}
                            {% else %}
                                No author
                            {% endif %}
                        </span>
                        <span>{{ post.createdAt ? post.createdAt|date('M d, Y') : '' }}</span>
                    </div>
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
