{% extends 'base.html.twig' %}

{% block title %}Posts — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="page-title">All Posts</h1>
        <p class="page-subtitle">{{ posts|length }} post{% if posts|length != 1 %}s{% endif %}</p>
    </div>
    <a href="{{ path('app_post_new') }}" class="btn btn-primary">+ New Post</a>
</div>

{% if posts is empty %}
    <div class="card empty-state"><p>No posts yet.</p></div>
{% else %}
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th>Tags</th>
                    <th>Comments</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                    <tr>
                        <td>
                            <a href="{{ path('app_post_show', {id: post.id}) }}" class="text-heading font-semibold" style="font-size:.875rem;color:var(--text-heading);transition:color .15s" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--text-heading)'">{{ post.title }}</a>
                        </td>
                        <td class="text-muted" style="font-size:.875rem">
                            {{ post.author ? post.author.name : '—' }}
                        </td>
                        <td><span class="badge badge-status-{{ post.status }}">{{ post.status }}</span></td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                {% for tag in post.tags %}
                                    <span class="tag-chip" style="background-color:{{ tag.color }};font-size:.7rem">{{ tag.name }}</span>
                                {% endfor %}
                            </div>
                        </td>
                        <td class="text-muted" style="font-size:.875rem">{{ post.comments|length }}</td>
                        <td class="text-right">
                            <div class="flex items-center gap-2" style="justify-content:flex-end">
                                <a href="{{ path('app_post_edit', {id: post.id}) }}" class="btn btn-ghost btn-xs">Edit</a>
                                <form method="post" action="{{ path('app_post_delete', {id: post.id}) }}" onsubmit="return confirm('Delete post?')" style="margin:0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                    <button type="submit" class="btn btn-danger btn-xs">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
