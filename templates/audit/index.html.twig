{% extends 'base.html.twig' %}

{% block title %}Audit History — AuditorBundle Demo{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="page-title">Audit History</h1>
        <p class="page-subtitle">{{ total }} entr{% if total != 1 %}ies{% else %}y{% endif %} total</p>
    </div>
    <a href="{{ path('dh_auditor_list_audits') }}" class="btn btn-secondary btn-sm">Native viewer →</a>
</div>

{# Filters #}
<form method="get" class="flex flex-wrap gap-3 mb-6">
    <select name="entity" class="form-select" style="width:auto">
        <option value="">All entities</option>
        {% for entity in auditable_entities %}
            <option value="{{ entity }}" {% if entity_filter == entity %}selected{% endif %}>{{ entity }}</option>
        {% endfor %}
    </select>
    <select name="type" class="form-select" style="width:auto">
        <option value="">All types</option>
        {% for type in audit_types %}
            <option value="{{ type }}" {% if type_filter == type %}selected{% endif %}>{{ type }}</option>
        {% endfor %}
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    {% if entity_filter or type_filter %}
        <a href="{{ path('app_audit_history') }}" class="btn btn-ghost btn-sm">Clear</a>
    {% endif %}
</form>

{% if entries is empty %}
    <div class="card empty-state">
        <p>No audit entries found.</p>
        <p style="font-size:.8rem;color:var(--text-subtle);margin-top:.5rem">Run <span class="code-inline">bin/console doctrine:fixtures:load</span> to generate data.</p>
    </div>
{% else %}
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Type</th>
                    <th>Entity</th>
                    <th>ID</th>
                    <th>User</th>
                    <th>Transaction</th>
                    <th>Changed fields</th>
                </tr>
            </thead>
            <tbody>
                {% for row in entries %}
                    {% set entry = row.entry %}
                    <tr>
                        <td class="whitespace-nowrap" style="font-size:.8rem;color:var(--text-muted)">
                            {{ entry.createdAt ? entry.createdAt|date('Y-m-d H:i:s') : '—' }}
                        </td>
                        <td class="whitespace-nowrap">
                            {% include '_partials/audit_badge.html.twig' with {type: entry.type} %}
                        </td>
                        <td>
                            <span class="badge badge-entity">{{ row.entity }}</span>
                        </td>
                        <td style="font-size:.8rem;color:var(--text-muted)">#{{ entry.objectId }}</td>
                        <td style="font-size:.8rem;color:var(--text-muted)">{{ entry.username ?? '—' }}</td>
                        <td>
                            {% if entry.transactionHash %}
                                <a href="{{ path('dh_auditor_show_transaction_stream', {hash: entry.transactionHash}) }}" class="tx-link" title="{{ entry.transactionHash }}">
                                    {{ entry.transactionHash|slice(0, 8) }}…
                                </a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td style="max-width:220px">
                            {% set diffs = entry.getDiffs() %}
                            {% if diffs is not empty %}
                                <div class="flex flex-wrap gap-1">
                                    {% for field, diff in diffs %}
                                        {% if diff is iterable %}
                                            {% set raw_old = diff.old ?? null %}
                                            {% set raw_new = diff.new ?? null %}
                                            {% set old_val = (raw_old is iterable) ? raw_old|json_encode : (raw_old ?? '') %}
                                            {% set new_val = (raw_new is iterable) ? raw_new|json_encode : (raw_new ?? '') %}
                                            <span class="badge badge-entity" title="{{ field }}: {{ old_val }} → {{ new_val }}">{{ field }}</span>
                                        {% else %}
                                            <span class="badge badge-entity" title="{{ field }}: {{ diff }}">{{ field }}</span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="text-muted" style="font-size:.8rem">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    {% if num_pages > 1 %}
        <div class="flex items-center justify-between" style="margin-top:1.5rem">
            <p class="text-muted" style="font-size:.875rem">Page {{ current_page }} of {{ num_pages }}</p>
            <div class="flex gap-2">
                {% if has_previous %}
                    <a href="{{ path('app_audit_history', {page: current_page - 1, entity: entity_filter, type: type_filter}) }}" class="btn btn-secondary btn-sm">← Previous</a>
                {% endif %}
                {% if has_next %}
                    <a href="{{ path('app_audit_history', {page: current_page + 1, entity: entity_filter, type: type_filter}) }}" class="btn btn-secondary btn-sm">Next →</a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endif %}
{% endblock %}
