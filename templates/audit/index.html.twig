{% extends 'base.html.twig' %}

{% block title %}Audit History — AuditorBundle Demo{% endblock %}

{% block stylesheets %}
    {# the rows of the viewer are styled with its Tailwind classes #}
    <link rel="stylesheet" href="{{ asset('bundles/dhauditor/app.css') }}">
{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="page-title">Audit History</h1>
        <p class="page-subtitle">Every action on the blog, one line per transaction, told as a phrase</p>
    </div>
    <a href="{{ path('dh_auditor_list_audits') }}" class="btn btn-secondary btn-sm" target="_blank">Native viewer →</a>
</div>

{# Filters #}
<form method="get" class="flex flex-wrap gap-3 mb-6">
    <select name="entity" class="form-select" style="width:auto">
        <option value="">All entities</option>
        {% for entity in auditable_entities %}
            <option value="{{ entity }}" {% if entity_filter == entity %}selected{% endif %}>{{ entity }}</option>
        {% endfor %}
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    {% if entity_filter %}
        <a href="{{ path('app_audit_history') }}" class="btn btn-ghost btn-sm">Clear</a>
    {% endif %}
</form>

{% if rows is empty %}
    <div class="card empty-state">
        <p>No audit entries found.</p>
        <p style="font-size:.8rem;color:var(--text-subtle);margin-top:.5rem">Run <span class="code-inline">bin/console app:fixtures:load</span> to generate data.</p>
    </div>
{% else %}
    <div class="card">
        <div class="card-body" style="padding-top:.25rem;padding-bottom:.25rem">
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                {% for row in rows %}
                    {{ include('@DHAuditor/History/_row.html.twig', {row: row, date_format: 'datetime', shorten: 4, details: is_granted('ROLE_ADMIN')}) }}
                {% endfor %}
            </ul>
        </div>
    </div>

    {% if has_previous or has_next %}
        <div class="flex items-center justify-between" style="margin-top:1.5rem">
            <p class="text-muted" style="font-size:.875rem">Page {{ current_page }}</p>
            <div class="flex gap-2">
                {% if has_previous %}
                    <a href="{{ path('app_audit_history', {page: current_page - 1, entity: entity_filter}) }}" class="btn btn-secondary btn-sm">← Newer</a>
                {% endif %}
                {% if has_next %}
                    <a href="{{ path('app_audit_history', {page: current_page + 1, entity: entity_filter}) }}" class="btn btn-secondary btn-sm">Older →</a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endif %}
{% endblock %}
