{% extends 'base.html.twig' %}

{% block title %}{{ author.name }} — AuditorBundle Demo{% endblock %}

{% block body %}
<a href="{{ path('app_author_index') }}" class="back-link">← Authors</a>

<div class="grid grid-main-aside">
    <div class="space-y-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h1 style="font-size:1.5rem;font-weight:800;color:var(--text-heading);margin:0">{{ author.name }}</h1>
                        <p class="text-primary" style="margin:.25rem 0 0;font-size:.875rem">{{ author.email }}</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('app_author_edit', {id: author.id}) }}" class="btn btn-secondary btn-sm">Edit</a>
                        <form method="post" action="{{ path('app_author_delete', {id: author.id}) }}" onsubmit="return confirm('Delete {{ author.name }}?')" style="margin:0">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ author.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
                {% if author.bio %}
                    <p style="color:var(--text);margin:0;line-height:1.7">{{ author.bio }}</p>
                {% else %}
                    <p class="text-muted italic" style="margin:0">No bio yet.</p>
                {% endif %}
            </div>
        </div>

        <div class="card">
            <div class="card-header">Posts ({{ author.posts|length }})</div>
            {% if author.posts is empty %}
                <div class="card-body text-muted" style="font-size:.875rem">No posts yet.</div>
            {% else %}
                <div style="padding:0 .25rem">
                    {% for post in author.posts %}
                        <div class="flex items-center justify-between" style="padding:.65rem 1.25rem;border-bottom:1px solid var(--border)">
                            <a href="{{ path('app_post_show', {id: post.id}) }}" class="text-primary" style="font-size:.875rem;font-weight:500">{{ post.title }}</a>
                            <span class="badge badge-status-{{ post.status }}">{{ post.status }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="space-y-4">
        <div class="card">
            <div class="card-header" style="display:flex;align-items:center;justify-content:space-between">
                <span>Recent Audits</span>
                <a href="{{ path('dh_auditor_show_entity_stream', {entity: 'App-Entity-Author', id: author.id}) }}" class="text-primary" style="font-size:.75rem;font-weight:500;text-transform:none;letter-spacing:0">View all →</a>
            </div>
            <div class="card-body">
                {% if audits is empty %}
                    <p class="text-muted" style="font-size:.875rem;margin:0">No audit entries yet.</p>
                {% else %}
                    <div class="space-y-3">
                        {% for entry in audits %}
                            <div>
                                <div class="flex items-center gap-2" style="margin-bottom:.2rem">
                                    {% include '_partials/audit_badge.html.twig' with {type: entry.type} %}
                                    <span class="text-muted" style="font-size:.75rem">{{ entry.createdAt ? entry.createdAt|date('M d, H:i') : '' }}</span>
                                </div>
                                {% if entry.username %}
                                    <p class="text-muted" style="font-size:.75rem;margin:0">by {{ entry.username }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
